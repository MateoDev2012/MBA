# Server port
PORT=3000

# Origins allowed by CORS.
# Use "*" (default) so anyone can consume the API from their own site.
# To restrict, comma-separate them: https://mysite.com,https://other.com
CORS_ORIGIN=*

# Cache TTLs in seconds, per data type.
# "playing" (active players) changes constantly -> short TTL.
# Thumbnail/banner barely ever change -> long TTL.
CACHE_TTL_STATS=30
CACHE_TTL_VOTES=300
CACHE_TTL_FAVORITES=600
CACHE_TTL_MEDIA=3600

# Request limit per IP, and window size in ms.
# These two are the fallback; the effective limit comes from the API key
# settings below when any key is configured.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# -----------------------------------------------------------------------------
# API keys
# -----------------------------------------------------------------------------
# Comma-separated list of your keys. Each entry can be:
#     key
#     key:Name
#     key:Name:allowed-domain.com,www.allowed-domain.com
# Separate multiple entries with a semicolon, because domains contain commas.
#
#   API_KEYS=Made by MoonlightStudios:Public key;other-key:Partner:partner.com
#
# Leave it empty and the API works with no key at all (a local checkout should
# not need setup). The moment you set it, API_KEY_MODE below decides what an
# unkeyed request is allowed to do.
#
# IMPORTANT: these keys travel inside a public .js file, so they are readable by
# anyone. A key is an identity, not a password. Do not put anything secret behind
# one, and do not treat a leaked key as a breach.
API_KEYS=

# off        no key needed. Only possible when API_KEYS is empty.
# optional   no key works but with a lower limit; a valid key gets the higher
#            one plus a per-key request count. The default once keys exist.
# required   every endpoint answers 401 without a valid key. This also takes
#            down this project's own documentation page and demo, which call the
#            API without a key, so set it deliberately.
API_KEY_MODE=optional

# Requests per minute. Anonymous callers get the first, keyed callers the
# second, and a keyed caller is counted per key as well as per IP.
RATE_LIMIT_ANON_MAX=30
RATE_LIMIT_KEYED_MAX=600

# Timeout for upstream requests to Roblox, in ms.
UPSTREAM_TIMEOUT_MS=10000

# Max characters accepted in a template by POST /api/v1/render.
RENDER_MAX_TEMPLATE_CHARS=200000

# User-Agent identifying your API to Roblox (Roblox asks for this).
USER_AGENT=RobloxStatsAPI/1.0 (+https://your-domain.com)
